// Written by COSMIC Terminal for its agent sessions. Changes are overwritten.
// Every key goes to the agent; the terminal's tab bar is the only UI.
keybinds clear-defaults=true {
}
default_mode "normal"
pane_frames false
simplified_ui true
show_startup_tips false
show_release_notes false
// Ended sessions should vanish rather than wait to be resurrected
session_serialization false
// Needed for the wheel to reach Zellij's scrollback; hold Shift to select
mouse_mode true
copy_on_select true
scroll_buffer_size 10000
